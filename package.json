{
  "name": "livepay-node",
  "version": "1.0.2",
  "description": "Production-ready, zero-dependency, typesafe TypeScript SDK for the LivePay Mobile Money API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "check:exports": "publint",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test && npm run check:exports"
  },
  "keywords": [
    "livepay",
    "mobile-money",
    "payments",
    "ugx",
    "kes",
    "ghs",
    "xaf",
    "mtn",
    "airtel",
    "safaricom",
    "sdk",
    "typescript"
  ],
  "author": "Codrone <mpalaronald@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codrone/livepay.git"
  },
  "bugs": {
    "url": "https://github.com/codrone/livepay/issues"
  },
  "homepage": "https://codrone.github.io/livepay/",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "publint": "^0.2.7",
    "tsup": "^8.0.2",
    "typedoc": "^0.25.10",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}
